# =============================================
# .htaccess - Configuración de seguridad para Constructora Damie
# =============================================

# 1) HEADERS DE SEGURIDAD BÁSICOS
# ---------------------------------------------

# Prevenir MIME type sniffing
Header set X-Content-Type-Options "nosniff"

# Prevenir clickjacking - solo permitir iframes del mismo origen
Header set X-Frame-Options "SAMEORIGIN"

# Política de referers estricta
Header set Referrer-Policy "strict-origin-when-cross-origin"

# HSTS (HTTP Strict Transport Security) - solo en producción con HTTPS
# Descomentar cuando el sitio tenga SSL:
# Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# 2) CONTENT SECURITY POLICY (CSP)
# ---------------------------------------------
# Política estricta que solo permite recursos del mismo origen
# y las imágenes de Unsplash (temporalmente)
Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; font-src 'self'; frame-src 'none'; object-src 'none'"

# NOTA: 'unsafe-inline' en style-src es necesario porque algunos estilos
# pueden estar inline en el HTML. En producción idealmente eliminarlo.

# 3) CACHÉ Y PERFORMANCE
# ---------------------------------------------

# Cachear recursos estáticos
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# No cachear HTML
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# 4) PROTECCIÓN CONTRA ATAQUES COMUNES
# ---------------------------------------------

# Proteger contra XSS (navegadores antiguos)
Header set X-XSS-Protection "1; mode=block"

# Prevenir que Google Chrome cargue recursos no HTTPS
# Header set Upgrade-Insecure-Requests "1"

# 5) COMPRESIÓN Y OPTIMIZACIÓN
# ---------------------------------------------

# Comprimir texto, HTML, CSS, JavaScript
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 6) URLS AMIGABLES Y REDIRECCIONES
# ---------------------------------------------

# Redirigir www a no-www (ajustar según dominio)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.constructora-damie\.com [NC]
# RewriteRule ^(.*)$ https://constructora-damie.com/$1 [L,R=301]

# 7) PROTECCIÓN DE ARCHIVOS SENSIBLES
# ---------------------------------------------

# Bloquear acceso a archivos de configuración
<FilesMatch "^(\.htaccess|\.htpasswd|\.git|\.env|composer\.json|package\.json)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Bloquear acceso a directorios sin index
Options -Indexes

# 8) ENCODING Y TIPOS MIME
# ---------------------------------------------

# Definir charset UTF-8
AddDefaultCharset UTF-8

# Tipos MIME para extensiones comunes
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg

# 9) ERROR PAGES PERSONALIZADAS (OPCIONAL)
# ---------------------------------------------
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# =============================================
# NOTAS DE IMPLEMENTACIÓN
# =============================================
# 
# 1. Este archivo requiere que el módulo mod_headers esté habilitado
#    en Apache. Para verificar: `sudo a2enmod headers`
#
# 2. Para Nginx, estas configuraciones deben ir en el bloque server
#    del archivo de configuración del sitio.
#
# 3. La CSP actual permite:
#    - Scripts y estilos solo del mismo origen
#    - Imágenes del mismo origen, data: URIs, y Unsplash
#    - No permite iframes, objetos, o recursos de otros dominios
#
# 4. Cuando se hosteen las imágenes localmente, cambiar img-src a:
#    img-src 'self' data:
#
# 5. En producción con HTTPS, descomentar:
#    - Strict-Transport-Security
#    - Upgrade-Insecure-Requests
#
# =============================================